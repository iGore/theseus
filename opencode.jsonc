{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "orchestrator",
  "mcp": {
    "context7": {
      "type": "local",
      "enabled": true,
      "command": [
        "npx",
        "-y",
        "@upstash/context7-mcp"
      ]
    },
    "sourcebot": {
      "type": "remote",
      "enabled": true,
      "url": "http://localhost:3000/api/mcp"
    },
    "websearch": {
      "enabled": false
    }
  }
}
